# 复制为 .env 并填入真实值（.env 严禁提交到仓库）

# ===== 大模型密钥（统一集中在此 .env，严禁提交仓库）=====

# 多模态识别模型（OpenAI 兼容 /chat/completions）
# 测试阶段：GLM-4V-Flash；上线切换：
#   VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   VISION_MODEL=qwen-vl-flash
VISION_ENABLED=false
VISION_API_KEY=
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VISION_MODEL=glm-4v-flash
VISION_TIMEOUT=20

# ===== 用户账号体系 =====

# 小程序 AppID（非密，与 client/project.config.json 保持一致）
WECHAT_APPID=wx683110d829c1f0f9
# 小程序 AppSecret（密；缺失时登录接口返回 2003，游客链路仍可用）
WECHAT_APP_SECRET=

# JWT 登录态（密；请填入足够随机的长字符串）
JWT_SECRET=
JWT_ACCESS_TTL=7200
JWT_REFRESH_TTL=2592000

# 数据库：开发期 SQLite；上线切换阿里云 RDS，例如：
#   DATABASE_URL=mysql+pymysql://user:pass@rds-host:3306/error_learn?charset=utf8mb4
DATABASE_URL=sqlite:///./app.db

# 识别接口是否强制登录后才能使用（回滚开关：false 恢复无鉴权旧行为）
AUTH_REQUIRED=true

# 头像上传上限（字节），默认 2MB
AVATAR_MAX_BYTES=2097152

# CORS 白名单（逗号分隔）；"*" 表示放开（开发期）
CORS_ORIGINS=*

# ===== 其它 =====

# AI 能力开关（本期固定 false）
AI_ENABLED=false

# 单张图片二进制上限（字节），默认 10MB
VISION_MAX_IMAGE_BYTES=10485760
