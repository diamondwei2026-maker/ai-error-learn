# 复制为 .env 并填入真实值（.env 严禁提交到仓库）

# ===== 大模型密钥（统一集中在此 .env，严禁提交仓库）=====

# 多模态识别模型（OpenAI 兼容 /chat/completions）
# 测试阶段：GLM-4V-Flash；上线切换：
#   VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   VISION_MODEL=qwen3-vl-flash
# 注意：模型名必须与所选平台实际模型 ID 一致，百炼不存在 qwen-vl-flash。
VISION_ENABLED=false
VISION_API_KEY=
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VISION_MODEL=glm-4v-flash
VISION_TIMEOUT=20

# ===== 用户账号体系 =====

# 小程序 AppID（非密，与 client/project.config.json 保持一致）
WECHAT_APPID=wxf7fbaf8d9a6f7296
# 小程序 AppSecret（密；缺失时登录接口返回 2003，游客链路仍可用）
WECHAT_APP_SECRET=

# JWT 登录态（密；请填入足够随机的长字符串）
JWT_SECRET=
JWT_ACCESS_TTL=7200
JWT_REFRESH_TTL=2592000

# 数据库：开发期 SQLite；上线切换阿里云 RDS，例如：
#   DATABASE_URL=mysql+pymysql://user:pass@rds-host:3306/error_learn?charset=utf8mb4
DATABASE_URL=sqlite:///./app.db

# 识别接口是否强制登录后才能使用（回滚开关：false 恢复无鉴权旧行为）
AUTH_REQUIRED=true

# 头像上传上限（字节），默认 2MB
AVATAR_MAX_BYTES=2097152

# CORS 白名单（逗号分隔）；"*" 表示放开（开发期）
CORS_ORIGINS=*

# ===== 微信内容安全（msgSecCheck / mediaCheckAsync）=====

# 总开关；置 false 即整体降级放行（应急回滚开关）
CONTENT_SECURITY_ENABLED=true
# 图片异步送检需公网可访问基地址（与 Nginx 域名一致，不带尾斜杠）；留空则跳过图片送检
PUBLIC_BASE_URL=
# 消息推送验签 Token（与 MP 后台「消息推送」配置一致；明文模式）
WECHAT_CALLBACK_TOKEN=
# 内容安全接口超时（秒）
CONTENT_SECURITY_TIMEOUT=10

# ===== 复习提醒（微信一次性订阅消息）=====
# 总开关；模板 ID 缺失时即使开启也不会启动调度（客户端降级为站内提醒）
REMINDER_ENABLED=false
# 订阅消息模板 ID（MP 后台「订阅消息」申请后填入）
REMINDER_TEMPLATE_ID=vxId8Kyj6pIlWCYJZik9sF65MmIMmzCQXGn0TULuaSw
# 点击消息跳转的小程序页面
REMINDER_PAGE=pages/quiz/index
# 每日发送时刻（时，东八区）
REMINDER_HOUR=20
# 调度时区；不依赖服务器系统时区
REMINDER_TIMEZONE=Asia/Shanghai
# 剩余可发送次数上限（每次授权 +1）
REMINDER_MAX_QUOTA=5
# 静默时段（时，左闭右开，支持跨午夜）
REMINDER_QUIET_START=21
REMINDER_QUIET_END=8

# ===== 其它 =====

# AI 举一反三（变式题生成）开关；关闭时接口返回 9001
AI_ENABLED=false
# 文本模型密钥（OpenAI 兼容，需与 AI_BASE_URL 平台一致）
AI_API_KEY=
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_MODEL=glm-4-flash
# 上游调用超时（秒）；客户端请求超时为 35s
AI_TIMEOUT=30
# 单次生成变式题数量
AI_MAX_VARIANTS=3

# 单张图片二进制上限（字节），默认 10MB
VISION_MAX_IMAGE_BYTES=10485760
