# 复制为 .env 并填入真实值（.env 严禁提交到仓库）
# 阿里云文字识别 OCR 访问密钥（建议使用 RAM 子账号，授予 AliyunOCRFullAccess）
ALIBABA_CLOUD_ACCESS_KEY_ID=your_access_key_id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_access_key_secret

# OCR 服务地址（默认华东1·杭州）
OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com

# 单张图片二进制上限（字节），默认 10MB
OCR_MAX_IMAGE_BYTES=10485760

# AI 能力开关（本期固定 false）
AI_ENABLED=false
