# 生产环境变量模板 —— 复制为 server/.env 后填入真实值
#
#   cp deploy/env.production.example server/.env
#   chmod 600 server/.env        # 含密钥，务必限制权限
#
# 说明：
# - server/.env 属于机密文件，已在 .gitignore 中排除，严禁提交仓库。
# - 应用启动时 config.py 会以 override=True 装载本文件，确保其为唯一权威来源。

# ===== 多模态识别模型（OpenAI 兼容 /chat/completions）=====
# 可选方案（模型名必须与所选平台实际模型 ID 完全一致）：
# ① 阿里云百炼官方：VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#    VISION_MODEL=qwen3-vl-flash（注意：百炼不存在 qwen-vl-flash）
# ② 智谱免费模型（当前生产使用）：
#    VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#    VISION_MODEL=glm-4v-flash
# ③ 第三方 OpenAI 兼容代理：模型目录各不相同，上线前先用
#    curl -H "Authorization: Bearer $KEY" "$VISION_BASE_URL/models" 核对；
#    实测某代理仅有 qwen3-vl-plus / qwen-vl-ocr，写 qwen-vl-flash 会返回 404 Model not exist，
#    最终表现为前端「识别失败，请重试或手动输入」。
VISION_ENABLED=true
VISION_API_KEY=
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VISION_MODEL=glm-4v-flash
VISION_TIMEOUT=20

# ===== 微信小程序账号体系 =====
# AppID（非密，与 client/project.config.json 一致）
WECHAT_APPID=wxf7fbaf8d9a6f7296
# AppSecret（密，从微信公众平台获取；请勿复用开发值）
WECHAT_APP_SECRET=

# ===== JWT 登录态 =====
# 使用足够随机的长字符串：openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL=7200
JWT_REFRESH_TTL=2592000

# ===== 数据库（阿里云 RDS MySQL 8.0）=====
# 注意：使用 MySQL 8 的 caching_sha2_password 认证，需安装 PyMySQL[rsa]
#       （cryptography 依赖），命令见部署教程第 2 章。
DATABASE_URL=mysql+pymysql://账号:密码@RDS内网地址:3306/error_learn?charset=utf8mb4

# ===== 鉴权与上传 =====
# 识别接口是否强制登录（应急回滚开关：false 恢复无鉴权旧行为）
AUTH_REQUIRED=true
# 头像上传上限（字节），默认 2MB
AVATAR_MAX_BYTES=2097152
# 单张识别图片上限（字节），默认 10MB
VISION_MAX_IMAGE_BYTES=10485760
# 静态资源根目录：必须与 Nginx `location /static/` 的 alias 保持一致
UPLOADS_DIR=/opt/error-learn/server/uploads

# ===== CORS =====
# 微信小程序请求不带 Origin 头，CORS 影响有限；如需 H5 预览再收敛为白名单
CORS_ORIGINS=*

# ===== 微信内容安全（msgSecCheck / mediaCheckAsync）=====
# 总开关；置 false 即整体降级放行（应急回滚开关）
CONTENT_SECURITY_ENABLED=true
# 图片异步送检要求 media_url 可被微信服务器下载，须填公网 HTTPS 基地址（不带尾斜杠）。
# 留空则跳过头像图片送检（仅做文本校验）。
PUBLIC_BASE_URL=https://errorlearn.diamondwtech.com
# 消息推送验签 Token：须与 MP 后台「开发管理 → 开发设置 → 消息推送」中配置的 Token 一致
WECHAT_CALLBACK_TOKEN=
# 内容安全接口超时（秒）
CONTENT_SECURITY_TIMEOUT=10

# ===== 复习提醒（微信一次性订阅消息）=====
# 总开关；模板 ID 缺失时即使开启也不会启动调度（客户端降级为站内提醒）
# 当前阶段关闭（不做学习提醒），恢复时改回 true
REMINDER_ENABLED=false
# 订阅消息模板 ID（MP 后台「订阅消息」申请后填入，个人主体仅一次性订阅）
REMINDER_TEMPLATE_ID=vxId8Kyj6pIlWCYJZik9sF65MmIMmzCQXGn0TULuaSw
# 点击消息跳转的小程序页面
REMINDER_PAGE=pages/quiz/index
# 每日发送时刻（时，东八区）
REMINDER_HOUR=20
# 调度时区；不依赖服务器系统时区
REMINDER_TIMEZONE=Asia/Shanghai
# 剩余可发送次数上限（每次授权 +1）
REMINDER_MAX_QUOTA=5
# 静默时段（时，左闭右开，支持跨午夜）
REMINDER_QUIET_START=21
REMINDER_QUIET_END=8

# ===== 其它 =====
# AI 能力开关（本期固定 false）
AI_ENABLED=false
