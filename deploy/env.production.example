# 生产环境变量模板 —— 复制为 server/.env 后填入真实值
#
#   cp deploy/env.production.example server/.env
#   chmod 600 server/.env        # 含密钥，务必限制权限
#
# 说明：
# - server/.env 属于机密文件，已在 .gitignore 中排除，严禁提交仓库。
# - 应用启动时 config.py 会以 override=True 装载本文件，确保其为唯一权威来源。

# ===== 多模态识别模型（OpenAI 兼容 /chat/completions）=====
# 生产建议切换为阿里云百炼（通义千问 VL），与 ECS/RDS 同厂商、网络更稳：
#   VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   VISION_MODEL=qwen-vl-flash
VISION_ENABLED=true
VISION_API_KEY=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-flash
VISION_TIMEOUT=20

# ===== 微信小程序账号体系 =====
# AppID（非密，与 client/project.config.json 一致）
WECHAT_APPID=wx683110d829c1f0f9
# AppSecret（密，从微信公众平台获取；请勿复用开发值）
WECHAT_APP_SECRET=

# ===== JWT 登录态 =====
# 使用足够随机的长字符串：openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL=7200
JWT_REFRESH_TTL=2592000

# ===== 数据库（阿里云 RDS MySQL 8.0）=====
# 注意：使用 MySQL 8 的 caching_sha2_password 认证，需安装 PyMySQL[rsa]
#       （cryptography 依赖），命令见部署教程第 2 章。
DATABASE_URL=mysql+pymysql://账号:密码@RDS内网地址:3306/error_learn?charset=utf8mb4

# ===== 鉴权与上传 =====
# 识别接口是否强制登录（应急回滚开关：false 恢复无鉴权旧行为）
AUTH_REQUIRED=true
# 头像上传上限（字节），默认 2MB
AVATAR_MAX_BYTES=2097152
# 单张识别图片上限（字节），默认 10MB
VISION_MAX_IMAGE_BYTES=10485760
# 静态资源根目录：必须与 Nginx `location /static/` 的 alias 保持一致
UPLOADS_DIR=/opt/error-learn/server/uploads

# ===== CORS =====
# 微信小程序请求不带 Origin 头，CORS 影响有限；如需 H5 预览再收敛为白名单
CORS_ORIGINS=*

# ===== 其它 =====
# AI 能力开关（本期固定 false）
AI_ENABLED=false
